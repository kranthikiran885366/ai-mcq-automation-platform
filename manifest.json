{
  "manifest_version": 3,
  "name": "Advanced AI MCQ Automation Bot — GPT-4 Quiz Solver",
  "version": "2.0.0",
  "description": "Auto-detect & answer any MCQ on any website using GPT-4, Gemini Pro & DeepSeek AI with 97%+ accuracy. Free open-source quiz automation bot by MVK Solutions.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "webNavigation",
    "tabCapture",
    "declarativeNetRequest",
    "alarms",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "modules/storage.js",
        "modules/whatsapp.js",
        "modules/screenshot.js",
        "modules/auto-answer.js",
        "modules/mcq-orchestrator.js",
        "modules/mcq-detector.js",
        "modules/mcq-automation-system.js",
        "modules/ui-dashboard.js",
        "modules/platform-config.js",
        "modules/error-handler.js",
        "modules/auto-fix-agent.js",
        "modules/code-writer.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "*.js", "tesseract.min.js", "html2canvas.min.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
